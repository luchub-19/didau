# URL API backend (để trống khi chạy local để dùng Vite proxy, điền URL Render khi deploy production)
# Ví dụ production: https://didau-backend.onrender.com
VITE_API_URL=

# Bật Mock Service Worker (chỉ dùng khi phát triển độc lập không có backend: true | false)
VITE_ENABLE_MOCK=false

# Style bản đồ MapLibre (để trống = OpenFreeMap Liberty)
VITE_MAP_STYLE_URL=

# Key Google Maps phía trình duyệt (giới hạn referrer). Để trống = chế độ OSM,
# frontend không gửi request nào tới googleapis.com.
VITE_GOOGLE_MAPS_BROWSER_KEY=
