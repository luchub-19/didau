# Môi trường ứng dụng (development | production)
APP_ENV=development
DEBUG=true

# Host & Cổng lắng nghe
HOST=0.0.0.0
PORT=8000

# Database URL (PostgreSQL)
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/didau
# Neon: postgresql://user:password@ep-sample-123.ap-southeast-1.neon.tech/didau?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/didau

# Allowed Origins (CORS & WebSocket), phân tách bằng dấu phẩy
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nạp dữ liệu mẫu khởi tạo khi container khởi động (true | false)
SEED_DEMO=false

# Định danh User-Agent khi gọi Nominatim OpenStreetMap API
NOMINATIM_USER_AGENT=DiDau/1.0 (student project)

# Nguồn dữ liệu quán: osm (mặc định) | google (bật khớp place_id, có đường lùi về osm)
PLACES_PROVIDER=osm

# Key Google phía server (chỉ bật Places API (New)); bỏ trống = tắt lớp Google
GOOGLE_MAPS_SERVER_KEY=

# Trần số lần gọi Google Text Search mỗi ngày
GOOGLE_MATCH_DAILY_LIMIT=1000
